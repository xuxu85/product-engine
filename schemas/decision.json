{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision.json",
  "type": "object",
  "required": ["stage", "decision", "invalidation_conditions"],
  "properties": {
    "stage": {"type": "string"},
    "decision": {"enum": ["PASS", "FAIL", "PIVOT"]},
    "output": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_stage": {"type": ["string", "null"]}
  }
}
