{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuxu85/product-engine/blob/main/schemas/agent-result.json",
  "title": "AgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "output",
    "evidence",
    "invalidation_conditions",
    "status",
    "confidence"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "ERROR"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PIVOT"
      ]
    },
    "output": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "invalidation_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "next_stage": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
