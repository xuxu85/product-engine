{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity Card Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "consumer", "pain", "pain_frequency", "pain_severity", "evidence_count", "target_price", "validation_cost", "capital_required", "invalidation_condition"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "consumer": {"type": "string"},
    "pain": {"type": "string", "minLength": 1},
    "pain_frequency": {"type": "integer", "minimum": 1},
    "pain_severity": {"type": "number", "minimum": 0, "maximum": 10},
    "evidence_count": {"type": "integer", "minimum": 1},
    "evidence_sources": {"type": "array", "items": {"type": "string"}},
    "target_price": {"type": "number", "exclusiveMinimum": 0},
    "validation_cost": {"type": "number", "minimum": 0},
    "capital_required": {"type": "number", "minimum": 0},
    "invalidation_condition": {"type": "string", "minLength": 1}
  }
}
